<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#0D1117"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="#3B82F6"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Corner Ornaments -->
        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:background="#3B82F6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#3B82F6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <CheckBox
            android:id="@+id/cbHabitDone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:buttonTint="@color/baby_blue"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvHabitName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:singleLine="true"
            android:text="HABIT NAME"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/cbHabitDone"
            app:layout_constraintEnd_toStartOf="@+id/llButtons"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/cbHabitDone"
            app:layout_constraintTop_toTopOf="@+id/cbHabitDone"
            app:layout_constrainedWidth="true" />

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/cbHabitDone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cbHabitDone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostHabit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="POST"
                android:textColor="#3B82F6"
                android:textSize="10sp"
                app:icon="@android:drawable/ic_menu_share"
                app:iconSize="12dp"
                app:iconTint="#3B82F6"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditHabit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:text="EDIT"
                android:textColor="#A78BFA"
                android:textSize="9sp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="#A78BFA" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteHabit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="4dp"
                android:text="DELETE"
                android:textColor="#EF4444"
                android:textSize="9sp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconPadding="2dp"
                app:iconSize="12dp"
                app:iconTint="#EF4444" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/topRowBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="cbHabitDone,tvHabitName,llButtons" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#1F2937"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topRowBarrier" />

        <LinearLayout
            android:id="@+id/llDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DURATION"
                android:textColor="#9CA3AF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHabitDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 Minutes"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProgressLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="OVERALL PROGRESS"
            android:textColor="#60A5FA"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llDuration" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/habitProgressIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:indicatorColor="#A78BFA"
            app:layout_constraintEnd_toStartOf="@+id/tvHabitPercentage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProgressLabel"
            app:trackColor="#1F2937"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/tvHabitPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="100%"
            android:textColor="#A78BFA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/habitProgressIndicator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/habitProgressIndicator" />

        <!-- Bottom Ornaments -->
        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:background="#3B82F6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#3B82F6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:layout_width="12dp"
            android:layout_height="2dp"
            android:background="#3B82F6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <View
            android:layout_width="2dp"
            android:layout_height="12dp"
            android:background="#3B82F6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
