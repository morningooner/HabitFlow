<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/denim"
    tools:context=".MainMenu">

    <!-- App Title (Solo Leveling System Style) -->

    <!-- TITLE -->
    <TextView
        android:id="@+id/mainMenuHomeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.2"
        android:shadowColor="@color/border"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="15"
        android:text="HabitFLOW"
        android:textColor="@color/baby_blue"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- System Interface Container-->
    <LinearLayout
        android:id="@+id/systemContainer"
        android:layout_width="379dp"
        android:layout_height="700dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/system"
        android:orientation="vertical"
        android:padding="48dp"
        android:layout_gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/mainMenuLogoutBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mainMenuHomeTV"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintWidth_max="550dp">

        <!-- System Header (Quest Directions style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="@color/baby_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:letterSpacing="0.1"
                android:text="SYSTEM INTERFACE"
                android:textColor="@color/baby_blue"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#3389CFEF" />

        <!-- Player Identity Section -->
        <TextView
            android:id="@+id/mainMenuHomeTV3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.1"
            android:shadowColor="@color/border"
            android:shadowRadius="10"
            android:text="PLAYER IDENTITY:"
            android:textColor="@color/baby_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mainMenuHomeTV4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:text="HOMER SIMPSON"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="SYSTEM STATUS: ONLINE"
            android:textColor="@color/baby_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.1"
            android:text="What would you like to do today?"
            android:textColor="@color/baby_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Navigation Grid Scroll -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbarSize="0dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- Habits Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHabit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="HABITS"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@android:drawable/ic_menu_today"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="@color/purple_200"
                    app:strokeColor="@color/baby_blue" />

                <!-- Profile Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Profile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="PROFILE"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@android:drawable/ic_menu_myplaces"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="@color/baby_blue" />

                <!-- Stats Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStatistics"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="STATS"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@android:drawable/ic_menu_sort_by_size"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#E02D03"
                    app:strokeColor="@color/baby_blue" />

                <!-- Play Session Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayHabit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="PLAY"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@drawable/outline_autoplay_24"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#1EE707"
                    app:strokeColor="@color/baby_blue" />

                <!-- Discover Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscover"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="DISCOVER"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@android:drawable/ic_menu_search"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#0363FF"
                    app:strokeColor="@color/baby_blue" />

                <!-- Leaderboard Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLeaderboard"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="LEADERS"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@drawable/outline_crown_24"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#FFEB3B"
                    app:strokeColor="@color/baby_blue" />

                <!-- Rank Status Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRankMenu"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_columnWeight="1"
                    android:text="RANK"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="4dp"
                    app:icon="@drawable/outline_cyclone_24"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconTint="#FF8102"
                    app:strokeColor="@color/baby_blue" />

            </GridLayout>
        </ScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:alpha="0.5"
            android:text="[ SYSTEM OVERRIDE ACTIVE ]"
            android:textColor="@color/baby_blue"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mainMenuLogoutBtn"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:letterSpacing="0.1"
        android:text="[ DISCONNECT_SYSTEM ]"
        android:textColor="#EF4444"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/systemContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
