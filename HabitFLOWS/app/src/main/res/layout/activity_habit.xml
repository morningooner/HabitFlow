<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/denim"
    tools:context=".Habit">

    <!-- Header Navigation -->
    <ImageView
        android:id="@+id/btnBackProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Back"
        android:padding="12dp"
        android:src="@drawable/outline_arrow_back_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/baby_blue" />

    <!-- Main Content Container (Solo Leveling System Style) -->
    <LinearLayout
        android:id="@+id/notificationContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/system"
        android:orientation="vertical"
        android:padding="48dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintWidth_max="550dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackProfile">

        <!-- Screen Title - Extra top margin to clear corner ornaments -->
        <TextView
            android:id="@+id/tvHabitHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:shadowColor="@color/border"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12"
            android:text="MY HABITS"
            android:textColor="@color/baby_blue"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Habits List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHabits"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_habit" />

    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddHabit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="Add Habit"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/baby_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/Widget.Material3.FloatingActionButton.Primary"
        app:tint="@color/denim" />

</androidx.constraintlayout.widget.ConstraintLayout>