<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/denim"
    tools:context=".ForgotPassword">

    <!-- Solo Leveling Notification Style Container -->
    <LinearLayout
        android:id="@+id/notificationContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/system"
        android:orientation="vertical"
        android:padding="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <TextView
            android:id="@+id/forgetPwdTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:text="FORGOT PASSWORD"
            android:textColor="@color/baby_blue"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:shadowColor="@color/border"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="You have requested to reset your credentials. Proceed with email authentication?"
            android:textColor="@color/baby_blue"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Email Address"
            android:textColorHint="@color/baby_blue"
            app:boxStrokeColor="@color/border"
            app:hintTextColor="@color/baby_blue"
            app:startIconTint="@color/baby_blue"
            app:boxBackgroundColor="#1A131E3A">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/forgetPwdEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgetPwdBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="ACCEPT RESET"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/denim"
            app:backgroundTint="@color/baby_blue"
            app:cornerRadius="4dp"
            app:rippleColor="@color/border" />

    </LinearLayout>

    <!-- Back to Login -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/forgetPwdBtnLogin"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Return to Login Menu"
        android:textAllCaps="false"
        android:textColor="@color/baby_blue"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>