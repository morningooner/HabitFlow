<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/systemContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/system"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:shadowColor="@color/border"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:text="SYSTEM NOTIFICATION"
            android:textColor="@color/baby_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@color/border"
            android:alpha="0.5" />

        <!-- Welcome Message -->
        <TextView
            android:id="@+id/tvWelcomePlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="WELCOME, PLAYER"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Update your daily log below."
            android:textColor="@color/baby_blue"
            android:textSize="12sp"
            android:alpha="0.8" />

        <!-- Notes Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Player Notes / Daily Log"
            android:textColorHint="@color/baby_blue"
            app:boxStrokeColor="@color/baby_blue"
            app:hintTextColor="@color/baby_blue">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPlayerNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button (Optional but fits the theme) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNotes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="SYNC WITH SYSTEM"
            android:textAllCaps="true"
            android:textColor="@color/denim"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/baby_blue"
            app:cornerRadius="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>